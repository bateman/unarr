# The Sonarr release Unarr emulates: the one place its version is written
# (issue #9). Read by scripts/sonarr-fixture.sh (the tarball `make ui`,
# `make golden` and `make sonarr` run), by the build of unarr-core
# (crates/unarr-core/build.rs: the identity, the metadata user agent, Plex,
# the tests), by scripts/compare-originals.py and scripts/upstream-triage.py.
# A new version is written here alone, scripts/tests/test_pins.py checks it:
# it fails if one of these values is written elsewhere (recordings, prose and
# upstream/sonarr.lock, the triage's cursor, aside; the test says why).
#
# version     the release, as `system/status` and `X-Application-Version` say it
# build_time  its `buildTime`, also the `Last-Modified` of what clients keep
# migration   its migration level, reported when nothing was imported
# sha256      of Sonarr.main.<version>.linux-x64.tar.gz, the tarball pinned
version = 4.0.20.3014
build_time = 2026-09-16T16:37:42Z
migration = 217
